<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_surface">

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/settings_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/settings"
                android:textColor="@color/text_primary_green"
                android:textSize="34sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/settings_scene"
                android:layout_width="@dimen/settings_scene_width"
                android:layout_height="@dimen/settings_scene_height"
                android:layout_marginTop="9dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/settings"
                android:scaleType="fitCenter"
                android:src="@drawable/settings_scene" />

            <LinearLayout
                android:id="@+id/settings_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="24dp"
                android:paddingEnd="@dimen/card_padding"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_chip_size"
                        android:layout_height="@dimen/icon_chip_size"
                        android:background="@drawable/bg_icon_chip"
                        android:contentDescription="@string/pomodoro_count_label"
                        android:padding="7dp"
                        android:src="@drawable/tomato_red" />

                    <TextView
                        android:id="@+id/pomodoro_count_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/pomodoro_count_label"
                        android:textColor="@color/text_primary_green"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/pomodoro_count_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="sans-serif-medium"
                        android:hint="@string/number_of_pomodoros"
                        android:inputType="number"
                        android:selectAllOnFocus="true"
                        android:textColor="@color/text_primary_green"
                        android:textColorHint="@color/text_secondary_green"
                        android:textSize="30sp" />

                    <ImageButton
                        android:id="@+id/pomodoro_count_increment"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/pomodoro_count_label"
                        android:padding="12dp"
                        android:src="@drawable/ic_arrow_up" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_soft_divider" />

                    <ImageButton
                        android:id="@+id/pomodoro_count_decrement"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/pomodoro_count_label"
                        android:padding="12dp"
                        android:src="@drawable/ic_arrow_down" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="26dp"
                    android:background="@drawable/bg_soft_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_chip_size"
                        android:layout_height="@dimen/icon_chip_size"
                        android:background="@drawable/bg_icon_chip"
                        android:contentDescription="@string/pomodoro_duration_label"
                        android:padding="9dp"
                        android:src="@drawable/ic_stopwatch" />

                    <TextView
                        android:id="@+id/pomodoro_duration_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/pomodoro_duration_label"
                        android:textColor="@color/text_primary_green"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/pomodoro_duration_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="sans-serif-medium"
                        android:hint="@string/pomodoro_duration_minutes"
                        android:inputType="number"
                        android:selectAllOnFocus="true"
                        android:textColor="@color/text_primary_green"
                        android:textColorHint="@color/text_secondary_green"
                        android:textSize="30sp" />

                    <ImageButton
                        android:id="@+id/pomodoro_duration_increment"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/pomodoro_duration_label"
                        android:padding="12dp"
                        android:src="@drawable/ic_arrow_up" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_soft_divider" />

                    <ImageButton
                        android:id="@+id/pomodoro_duration_decrement"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/pomodoro_duration_label"
                        android:padding="12dp"
                        android:src="@drawable/ic_arrow_down" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="26dp"
                    android:background="@drawable/bg_soft_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_chip_size"
                        android:layout_height="@dimen/icon_chip_size"
                        android:background="@drawable/bg_icon_chip"
                        android:contentDescription="@string/pomodoro_labels_checkbox"
                        android:padding="10dp"
                        android:src="@drawable/ic_tag" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/pomodoro_labels_checkbox"
                        android:textColor="@color/text_primary_green"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/pomodoro_labels_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:showText="false" />
                </LinearLayout>

                <Button
                    android:id="@+id/save_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/rounded_button"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/save"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/appVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="46dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="46dp"
                android:text="@string/version_info"
                android:textColor="@color/text_secondary_green"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_marginStart="@dimen/bottom_nav_margin"
        android:layout_marginEnd="@dimen/bottom_nav_margin"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/home_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_nav_item_height"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:contentDescription="@string/home"
                android:src="@drawable/tomato_red" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statistics_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_nav_item_height"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:contentDescription="@string/statistics"
                android:padding="3dp"
                android:src="@drawable/ic_statistics"
                android:tint="@color/nav_inactive" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/bottom_nav_item_height"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_selected"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="@dimen/nav_icon_size"
                android:layout_height="@dimen/nav_icon_size"
                android:contentDescription="@string/settings"
                android:padding="2dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/timer_green" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
