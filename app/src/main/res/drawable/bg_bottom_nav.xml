<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="6dp"
        android:bottom="0dp">
        <shape>
            <solid android:color="#08000000" />
            <corners android:radius="36dp" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:right="3dp"
        android:top="8dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#12000000" />
            <corners android:radius="35dp" />
        </shape>
    </item>
    <item
        android:left="5dp"
        android:right="5dp"
        android:top="0dp"
        android:bottom="10dp">
        <shape>
            <solid android:color="@color/surface_card" />
            <corners android:radius="34dp" />
            <stroke
                android:width="1dp"
                android:color="@color/white" />
        </shape>
    </item>
</layer-list>
