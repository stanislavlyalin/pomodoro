<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="6dp"
        android:bottom="0dp">
        <shape>
            <solid android:color="#08000000" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="7dp"
        android:bottom="1dp">
        <shape>
            <solid android:color="#10000000" />
            <corners android:radius="31dp" />
        </shape>
    </item>
    <item
        android:left="6dp"
        android:right="6dp"
        android:top="8dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#15000000" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:right="8dp"
        android:top="0dp"
        android:bottom="10dp">
        <shape>
            <solid android:color="@color/surface_card" />
            <corners android:radius="@dimen/card_corner_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/white" />
        </shape>
    </item>
</layer-list>
